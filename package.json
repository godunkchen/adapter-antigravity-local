{
  "name": "@weslleycapelari/adapter-antigravity-local",
  "version": "2.7.0",
  "license": "MIT",
  "homepage": "https://github.com/weslleycapelari/adapter-antigravity-local",
  "scripts": {
    "build": "tsc && npx esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@paperclipai/adapter-utils --external:picocolors --external:node:* && tsc src/ui-parser.ts --outDir dist --target ES2020 --module CommonJS --declaration false && cp package.json dist/",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "paperclip": {
    "adapterUiParser": "1.0.0"
  },
  "bugs": {
    "url": "https://github.com/weslleycapelari/adapter-antigravity-local/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/weslleycapelari/adapter-antigravity-local"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/index.js",
    "./ui": "./dist/ui/index.js",
    "./cli": "./dist/cli/index.js",
    "./ui-parser": "./dist/ui-parser.js"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./ui": {
        "types": "./dist/ui/index.d.ts",
        "import": "./dist/ui/index.js"
      },
      "./cli": {
        "types": "./dist/cli/index.d.ts",
        "import": "./dist/cli/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "skills"
  ],
  "dependencies": {
    "@paperclipai/adapter-utils": "^2026.525.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.7"
  }
}
